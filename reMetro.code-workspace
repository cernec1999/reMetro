{
    "folders": [
        {
            "name": "☕ Metro Fetch Service (Java)",
            "path": "./remetro-fetch"
        },
        {
            "name": "📦 Protobuf Definitions",
            "path": "./remetro-protobuf"
        },
        {
            "name": "🦀 Rust Common Library",
            "path": "./remetro-common"
        },
        {
            "name": "📟 Rust ESP32S3 Firmware",
            "path": "./remetro-esp32s3"
        },
        {
            "name": "🖌️ Metro Render Library",
            "path": "./remetro-render"
        },
        {
            "name": "☁️ Cloud",
            "path": "./remetro-cloud"
        },
        {
            "name": "🔧 Font Builder",
            "path": "./remetro-font"
        },
        {
            "name": "🖥️ Desktop Simulator",
            "path": "./remetro-simulator"
        },
        {
            "name": "📁 Root",
            "path": "."
        }
    ],
    "settings": {
        // Global settings
        "files.associations": {
            "*.rs": "rust",
            "*.toml": "toml",
            "*.proto": "proto3"
        },

        // Rust Analyzer
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.autoreload": true,
        "[rust]": {
            "editor.defaultFormatter": "rust-lang.rust-analyzer",
            "editor.formatOnSave": true
        },

        // Java
        "[java]": {
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "redhat.java"
        },
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.compile.nullAnalysis.mode": "automatic",
        "java.project.sourcePaths": [
            "src/main/java",
            "target/generated-sources/protobuf",
            "target/generated-sources/openapi/src/main/java"
        ],

        // Terminal settings
        "terminal.integrated.cwd": "${workspaceFolder}",

        // File explorer
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
            "Cargo.toml": "Cargo.lock,rust-toolchain.toml,.cargo/",
            "*.rs": "$(capture).exe,$(capture).pdb",
            "pom.xml": ".mvn/,mvnw,mvnw.cmd"
        }
    }
}
