{
    "folders": [
        {
            "name": "🦀 Rust Common Library", 
            "path": "./remetro-common"
        },
        {
            "name": "📟 Rust ESP32S3 Firmware",
            "path": "./remetro-esp32s3"
        },
        {
            "name": "🖌️ Metro Render Library", 
            "path": "./remetro-render"
        },
        {
            "name": "🚄 Metro Fetch API",
            "path": "./remetro-fetch"
        },
        {
            "name": "☁️ Cloud",
            "path": "./remetro-cloud"
        },
        {
            "name": "🔧 Font Builder",
            "path": "./remetro-font"
        },
        {
            "name": "🖥️ Desktop Simulator",
            "path": "./remetro-simulator"
        },
        {
            "name": "📁 Root",
            "path": "."
        }
    ],
    "settings": {
        // Global settings
        "files.associations": {
            "*.rs": "rust",
            "*.toml": "toml"
        },
        
        // Rust Analyzer - Default to desktop development
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.autoreload": true,
        
        // Different Rust Analyzer configs per folder
        "[rust]": {
            "editor.defaultFormatter": "rust-lang.rust-analyzer",
            "editor.formatOnSave": true
        },
        
        // Terminal settings
        "terminal.integrated.cwd": "${workspaceFolder}",
        
        // File explorer
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
            "Cargo.toml": "Cargo.lock,rust-toolchain.toml,.cargo/",
            "*.rs": "$(capture).exe,$(capture).pdb"
        }
    },
}