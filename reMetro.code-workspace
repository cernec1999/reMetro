{
    "folders": [
        {
            "name": "🖥️ Desktop Simulator",
            "path": "./metro-simulator"
        },
        {
            "name": "🎨 Render Library", 
            "path": "./metro-render"
        },
        {
            "name": "🔧 ESP32 Firmware",
            "path": "./metro-esp32"
        },
        {
            "name": "🔧 Font Builder",
            "path": "./metro-font-builder"
        },
        {
            "name": "📁 Root",
            "path": "."
        }
    ],
    "settings": {
        // Global settings
        "files.associations": {
            "*.rs": "rust",
            "*.toml": "toml"
        },
        
        // Rust Analyzer - Default to desktop development
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.autoreload": true,
        
        // Different Rust Analyzer configs per folder
        "[rust]": {
            "editor.defaultFormatter": "rust-lang.rust-analyzer",
            "editor.formatOnSave": true
        },
        
        // Terminal settings
        "terminal.integrated.cwd": "${workspaceFolder}",
        
        // File explorer
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
            "Cargo.toml": "Cargo.lock,rust-toolchain.toml,.cargo/",
            "*.rs": "$(capture).exe,$(capture).pdb"
        }
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Build Simulator",
                "type": "shell",
                "command": "cargo",
                "args": ["build"],
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder}/metro-simulator"
                },
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "shared"
                },
                "problemMatcher": ["$rustc"]
            },
            {
                "label": "Run Simulator",
                "type": "shell", 
                "command": "cargo",
                "args": ["run"],
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder}/metro-simulator"
                },
                "presentation": {
                    "echo": true,
                    "reveal": "always", 
                    "focus": false,
                    "panel": "shared"
                },
                "problemMatcher": ["$rustc"]
            },
            {
                "label": "Build ESP32",
                "type": "shell",
                "command": "rustup",
                "args": ["run", "esp", "cargo", "build"],
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder}/metro-esp32"
                },
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "shared"
                },
                "problemMatcher": ["$rustc"]
            },
            {
                "label": "Flash ESP32",
                "type": "shell",
                "command": "rustup", 
                "args": ["run", "esp", "cargo", "run", "--release"],
                "group": "build",
                "options": {
                    "cwd": "${workspaceFolder}/metro-esp32"
                },
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "shared"
                },
                "problemMatcher": ["$rustc"]
            },
            {
                "label": "Build Render Library",
                "type": "shell",
                "command": "cargo",
                "args": ["build"],
                "group": "build", 
                "options": {
                    "cwd": "${workspaceFolder}/metro-render"
                },
                "presentation": {
                    "echo": true,
                    "reveal": "always",
                    "focus": false,
                    "panel": "shared"
                },
                "problemMatcher": ["$rustc"]
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Simulator",
                "type": "cppvsdbg",
                "request": "launch",
                "program": "${workspaceFolder}/metro-simulator/target/debug/metro-simulator.exe",
                "args": [],
                "cwd": "${workspaceFolder}/metro-simulator",
                "preLaunchTask": "Build Simulator",
                "stopAtEntry": false,
                "environment": [],
                "console": "externalTerminal"
            }
        ]
    }
}